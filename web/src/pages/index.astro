---
import Layout from '../layouts/Layout.astro';
import { editions, inks } from '../data/themes';

const steps = [
  { name: 'auth', when: 'once', writes: 'tokens into config.toml, mode 0600',
    cmd: 'patinate auth',
    note: 'OAuth with Strava, scope activity:read_all. The token refreshes itself after that.' },
  { name: 'fetch-osm', when: 'once per city', writes: 'basemap.osm.json in the user cache dir',
    cmd: 'patinate fetch-osm --city "Your City, USA" --radius-m 25000',
    note: 'The OpenStreetMap basemap, from Overpass. Fetch again when you move or change the radius.' },
  { name: 'sync', when: 'after rides', writes: 'cache.db (SQLite) in the user data dir',
    cmd: 'patinate sync',
    note: 'An incremental pull of your activities. The only command you run often.' },
  { name: 'render', when: 'whenever', writes: 'heatmap.svg, or whatever --out names',
    cmd: 'patinate render --theme warm_beige --cycling --out heatmap.svg',
    note: 'Composes the poster from what is on disk. No network.' },
];

const exits = [
  { name: 'A print to hang', cmd: 'patinate render --theme noir_heat --anonymize --out poster.svg\nrsvg-convert -w 3600 poster.svg -o poster.png',
    note: 'The full poster: six road tiers, glow, heat and the text plate. Rasterize it for a print shop.' },
  { name: 'A page ground', cmd: 'patinate render --theme cycle_heat --cycling --web \\\n  --transparent-bg --anonymize --out ground.svg',
    note: 'No text plate and no minor roads, over your own page color. cycle.dunn.dev is set on one.' },
  { name: 'An inline SVG', cmd: 'patinate render --theme cycle_heat --web --out inline.svg',
    note: 'Keeps the data-type, data-year and data-bike attributes for page filters. Pass --anonymize before it goes public.' },
];
---
<Layout title="Home" description="patinate renders your Strava activity onto a city basemap as a poster. Six themes, a press to try them on sample data, and the docs to run it.">
  <section class="hero">
    <div>
      <p class="stamp">a poster press · Strava in, prints out</p>
      <h1>Posters pulled from <em>the roads you ride.</em></h1>
      <p class="lede">
        patinate draws your Strava activity onto a city basemap, one
        low-alpha stroke per ride. Where you ride often the strokes stack
        and the color deepens, the way patina builds on metal.
      </p>
      <div class="cta-row">
        <a class="btn primary" href="/playground/">Open the press</a>
        <a class="btn" href="/docs/#install">Install</a>
        <code>cargo install patinate</code>
      </div>
    </div>
    <figure class="pull">
      <span class="marks"></span>
      <img src="/plates/hero.webp" width="960" height="1280" fetchpriority="high"
        alt="A patinate poster of Grand Rapids in noir_heat: orange heat strokes over white roads on a black ground." />
      <figcaption class="caption stamp"><span>noir_heat</span><span>sample data · Grand Rapids</span></figcaption>
    </figure>
  </section>

  <section class="section" id="prints">
    <div class="section-head">
      <p class="stamp">the prints</p>
      <h2>Six themes, one city.</h2>
      <p class="lede">The bundled Grand Rapids sample through every theme the binary ships. Open any of them on the press to change the inks.</p>
    </div>
    <div class="wall">
      {editions.map(({ theme, note }, i) => (
        <figure>
          <a class="frame" href={`/playground/#${theme.name}`}>
            <img src={`/plates/${theme.name}.webp`} width="600" height="800" loading={i < 2 ? 'eager' : 'lazy'}
              alt={`Grand Rapids sample rendered in ${theme.name}`} />
          </a>
          <div class="inkbar" aria-hidden="true">{inks(theme).map((c) => <i style={`background:${c}`}></i>)}</div>
          <figcaption>
            <div class="edition"><span class="name"><a href={`/playground/#${theme.name}`}>{theme.name}</a></span><span class="stamp">{String(i + 1).padStart(2, '0')}</span></div>
            <p class="note">{note}</p>
          </figcaption>
        </figure>
      ))}
    </div>
    <p class="hint" style="margin-top:var(--space-4)">Each print is <code>patinate render --theme &lt;name&gt; --heat-bloom 1.8 --heat-alpha 2.5</code> on <code>fixtures/</code>, rendered at build time with <code>just web</code>.</p>
  </section>

  <section class="section" id="plates">
    <div class="section-head">
      <p class="stamp">the plates</p>
      <h2>Four layers, in register.</h2>
      <p class="lede">A render is layered the way a print is: a ground, then each plate in its own ink. Every plate answers to a flag.</p>
    </div>
    <div class="plates">
      <div class="plate"><p class="stamp">basemap</p><h3>Streets and water</h3><p>OpenStreetMap roads in six tiers, water and parks. Leave it off with <code>--heat-only</code>.</p></div>
      <div class="plate"><p class="stamp">glow</p><h3>The bloom</h3><p>Two wide, faint passes of the heat ink under the sharp one. Scale it with <code>--heat-bloom</code>; 0 is a hard line.</p></div>
      <div class="plate"><p class="stamp">heat</p><h3>The rides</h3><p>One stroke per activity, cut at the privacy zone before it is drawn. Scale its opacity with <code>--heat-alpha</code>.</p></div>
      <div class="plate"><p class="stamp">text</p><h3>The colophon</h3><p>City, count and scale bar. <code>--web</code> leaves it off so a page can set its own.</p></div>
    </div>
  </section>

  <section class="section" id="run">
    <div class="section-head">
      <p class="stamp">operating sequence</p>
      <h2>Four commands, in this order.</h2>
      <p class="lede">A single Rust binary. Strava and OpenStreetMap own the upstream data, your disk holds the caches, and <code>render</code> works only from what is on disk.</p>
    </div>
    <div class="plates">
      {steps.map((s) => (
        <div class="plate">
          <p class="stamp">{s.when}</p>
          <h3>{s.name}</h3>
          <pre class="copyable"><code>{s.cmd}</code></pre>
          <p>{s.note}</p>
          <p class="hint">writes {s.writes}</p>
        </div>
      ))}
    </div>
    <p style="margin-top:var(--space-5)"><a href="/docs/">The docs: config, themes, every render flag →</a></p>
  </section>

  <section class="section" id="exits">
    <div class="section-head">
      <p class="stamp">after render</p>
      <h2>Three ways a render leaves the machine.</h2>
    </div>
    <div class="plates">
      {exits.map((e) => (
        <div class="plate">
          <h3>{e.name}</h3>
          <pre class="copyable"><code>{e.cmd}</code></pre>
          <p>{e.note}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section" id="privacy">
    <div class="section-head">
      <p class="stamp">privacy</p>
      <h2>What the zone hides, and what it doesn't.</h2>
    </div>
    <div class="prose">
      <p>Nothing inside <code>obfuscation_radius_m</code> of home reaches the SVG. The hidden zone is offset from home in a direction and distance only your <code>[privacy] salt</code> knows, up to <code>offset_m</code> (750 m by default), and each cut end is trimmed a little further along the track.</p>
      <p>It does not hide everything. Tracks still converge toward home, and a determined analyst can narrow it to roughly 100 to 250 m. A larger radius adds only modest cover. <strong>Treat it as a tool you check, not a promise.</strong></p>
      <p>For anything public, also pass <code>--anonymize</code>: it drops the <code>data-*</code> attributes and the <code>&lt;desc&gt;</code> that carries the center coordinates. Everything on this site is the bundled sample: seeded random walks over the Grand Rapids road graph, no real rider.</p>
    </div>
  </section>
</Layout>
